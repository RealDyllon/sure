<div class="space-y-4">
  <%# Resolve the active items once at the top so the "Connect another" / %>
  <%# "Connect with Wise" copy and the "Configured" indicator stay in sync. %>
  <% items = local_assigns[:wise_items] || @wise_items || Current.family.wise_items.active %>

  <% error_msg = local_assigns[:error_message] || @error_message %>
  <% if error_msg.present? %>
    <div class="p-2 rounded-md bg-destructive/10 text-destructive text-sm overflow-hidden">
      <p class="line-clamp-3" title="<%= error_msg %>"><%= error_msg %></p>
    </div>
  <% end %>

  <div class="prose prose-sm text-secondary">
    <p class="text-primary font-medium"><%= t("settings.providers.wise.connection_title", default: "Connection") %></p>
    <p><%= t("settings.providers.wise.oauth_description") %></p>
  </div>

  <div class="flex items-center gap-3">
    <% if Provider::Wise.oauth_configured? %>
      <%= render DS::Link.new(
        text: t("settings.providers.wise.#{items&.any? ? 'connect_another' : 'connect'}"),
        icon: "link",
        variant: "primary",
        href: oauth_start_wise_items_path,
        frame: :_top
      ) %>
    <% else %>
      <div class="p-3 rounded-lg border border-primary bg-surface text-sm text-secondary">
        <%= t("settings.providers.wise.not_configured").html_safe %>
      </div>
    <% end %>
  </div>

  <div class="border border-primary rounded-lg p-3 space-y-3">
    <div class="text-sm">
      <p class="font-medium text-primary"><%= t("settings.providers.wise.limited_token_title") %></p>
      <p class="text-secondary"><%= t("settings.providers.wise.limited_token_description") %></p>
    </div>

    <%= styled_form_with model: WiseItem.new,
                         url: wise_items_path,
                         scope: :wise_item,
                         method: :post,
                         data: { turbo: true },
                         class: "space-y-3" do |form| %>
      <%= form.text_field :personal_token,
                          label: t("settings.providers.wise.limited_token_label"),
                          placeholder: t("settings.providers.wise.limited_token_placeholder"),
                          type: :password %>
      <%= form.text_field :base_url,
                          label: t("settings.providers.wise.base_url_label"),
                          placeholder: Provider::Wise::DEFAULT_BASE_URL %>
      <div class="flex justify-end">
        <%= form.submit t("settings.providers.wise.save_limited"),
                        class: "inline-flex items-center justify-center rounded-lg px-4 py-2 text-sm font-medium text-inverse button-bg-primary hover:button-bg-primary-hover focus:outline-none focus:ring-2 focus:ring-gray-900 theme-dark:focus:ring-white focus:ring-offset-2 transition-colors" %>
      </div>
    <% end %>
  </div>

  <div class="space-y-2">
    <div class="flex items-center gap-2">
      <% if items&.any? %>
        <div class="w-2 h-2 bg-success rounded-full"></div>
        <p class="text-sm text-secondary"><%= t("settings.providers.wise.configured").html_safe %></p>
      <% else %>
        <div class="w-2 h-2 bg-gray-400 rounded-full"></div>
        <p class="text-sm text-secondary"><%= t("settings.providers.wise.not_configured_short") %></p>
      <% end %>
    </div>
  </div>
</div>

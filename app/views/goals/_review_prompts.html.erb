<% prompts = Array(local_assigns.fetch(:prompts, [])).map(&:to_sym) %>

<% if prompts.any? %>
  <section data-testid="goals-review-prompts" class="bg-warning/10 border border-warning/30 rounded-xl p-4 space-y-3">
    <% if prompts.include?(:srs_mapping) %>
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3">
        <p class="text-sm text-primary"><%= t("goals.review_prompts.srs_mapping") %></p>
        <div class="flex items-center gap-3">
          <%= link_to t("goals.review_prompts.srs_map_link"), goals_assumptions_path, class: "text-sm font-medium text-primary underline" %>
          <%= button_to t("goals.review_prompts.srs_skip"), skip_prompt_goals_account_mappings_path(prompt: "srs"), method: :patch, class: "text-sm text-secondary underline" %>
        </div>
      </div>
    <% end %>

    <% if prompts.include?(:fx_unavailable) %>
      <p class="text-sm text-primary"><%= t("goals.review_prompts.fx_unavailable") %></p>
    <% end %>

    <% if prompts.include?(:current_age_missing) %>
      <p class="text-sm text-primary"><%= t("goals.review_prompts.current_age_missing") %></p>
    <% end %>
  </section>
<% end %>

<% header_title t("goals.index.title") %>

<div class="max-w-6xl mx-auto py-6 space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-3xl text-primary font-medium"><%= t("goals.index.title") %></h1>
      <p class="text-sm text-secondary"><%= t("goals.index.subtitle") %></p>
    </div>
  </div>

  <%= render "goals/review_prompts", prompts: @fire.review_prompts %>

  <section data-testid="fire-hero" class="bg-container shadow-border-xs rounded-xl p-5 space-y-4">
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 class="text-xl text-primary font-medium"><%= t("goals.fire.card.title") %></h2>
        <p class="text-sm text-secondary"><%= t("goals.fire.card.subtitle") %></p>
      </div>

      <%= link_to t("goals.fire.card.review_assumptions"), goals_assumptions_path, class: "text-sm font-medium text-primary underline" %>
    </div>

    <div class="grid md:grid-cols-3 gap-3">
      <div class="bg-surface rounded-lg p-4">
        <p class="text-sm text-secondary"><%= t("goals.fire.card.headline_progress") %></p>
        <p class="text-2xl font-medium text-primary"><%= number_to_percentage(@fire.headline_progress * 100, precision: 0) %></p>
      </div>
      <div class="bg-surface rounded-lg p-4">
        <p class="text-sm text-secondary"><%= t("goals.fire.card.estimated_fi_target") %></p>
        <p class="text-2xl font-medium text-primary privacy-sensitive"><%= @fire.fi_target_money.format %></p>
      </div>
      <div class="bg-surface rounded-lg p-4">
        <p class="text-sm text-secondary"><%= t("goals.fire.card.bridge_assets") %></p>
        <p class="text-2xl font-medium text-primary privacy-sensitive"><%= @fire.bridge_assets_money.format %></p>
      </div>
      <div class="bg-surface rounded-lg p-4">
        <p class="text-sm text-secondary"><%= t("goals.fire.card.later_assets") %></p>
        <p class="text-2xl font-medium text-primary privacy-sensitive"><%= @fire.later_assets_money.format %></p>
      </div>
    </div>

    <%= link_to t("goals.fire.card.view_details"), goals_fire_path, class: "text-sm font-medium text-primary underline" %>
  </section>

  <section class="grid lg:grid-cols-3 gap-4">
    <article class="bg-container shadow-border-xs rounded-xl p-5 space-y-3">
      <h2 class="text-lg text-primary font-medium"><%= t("goals.emergency_fund.title") %></h2>
      <p class="text-sm text-secondary"><%= t("goals.emergency_fund.subtitle") %></p>
      <p class="text-2xl font-medium text-primary privacy-sensitive"><%= @dashboard.emergency_fund.available_money.format %></p>
      <% if @dashboard.emergency_fund.current_months %>
        <p class="text-sm text-secondary"><%= t("goals.emergency_fund.current", months: @dashboard.emergency_fund.current_months) %></p>
      <% end %>
      <p class="text-sm text-secondary">
        <%= t("goals.emergency_fund.target_html", amount: @dashboard.emergency_fund.target_money.format) %>
      </p>
      <% if @dashboard.emergency_fund.review_prompts.include?(:fx_unavailable) %>
        <p class="text-sm text-warning"><%= t("goals.emergency_fund.fx_unavailable") %></p>
      <% end %>
    </article>

    <article class="bg-container shadow-border-xs rounded-xl p-5 space-y-3">
      <h2 class="text-lg text-primary font-medium"><%= t("goals.debt_payoff.title") %></h2>
      <p class="text-sm text-secondary"><%= t("goals.debt_payoff.subtitle") %></p>
      <p class="text-2xl font-medium text-primary privacy-sensitive"><%= @dashboard.debt_payoff.total_debt_money.format %></p>
      <% if @dashboard.debt_payoff.estimated_months %>
        <p class="text-sm text-secondary"><%= t("goals.debt_payoff.estimated_months", months: @dashboard.debt_payoff.estimated_months) %></p>
        <% if @dashboard.debt_payoff.debt_accounts.any? { |a| a.accountable_type == "Loan" } %>
          <p class="text-xs text-secondary"><%= t("goals.debt_payoff.loan_terms_note") %></p>
        <% end %>
      <% elsif @dashboard.debt_payoff.debt_accounts.any? %>
        <p class="text-sm text-secondary"><%= t("goals.debt_payoff.balance_only") %></p>
        <% missing_payment_names = @dashboard.debt_payoff.debt_accounts.select { |a| @dashboard.debt_payoff.reason_for(a) == :payment_missing }.map(&:name) %>
        <% fx_unavailable_names = @dashboard.debt_payoff.debt_accounts.select { |a| @dashboard.debt_payoff.reason_for(a) == :fx_unavailable }.map(&:name) %>
        <% if missing_payment_names.any? %>
          <p class="text-sm text-secondary"><%= t("goals.debt_payoff.payment_info_missing") %></p>
        <% end %>
        <% fx_unavailable_names.each do |name| %>
          <p class="text-sm text-warning"><%= t("goals.debt_payoff.payment_fx_unavailable", name: name) %></p>
        <% end %>
      <% end %>
      <% if @dashboard.debt_payoff.unsupported_accounts.any? %>
        <p class="text-sm text-warning"><%= t("goals.debt_payoff.review_accounts", count: @dashboard.debt_payoff.unsupported_accounts.count) %></p>
      <% end %>
    </article>

    <article class="bg-container shadow-border-xs rounded-xl p-5 space-y-3">
      <h2 class="text-lg text-primary font-medium"><%= t("goals.savings_rate.title") %></h2>
      <p class="text-sm text-secondary"><%= t("goals.savings_rate.subtitle") %></p>
      <% if @dashboard.savings_rate.savings_rate %>
        <p class="text-2xl font-medium text-primary"><%= number_to_percentage(@dashboard.savings_rate.savings_rate * 100, precision: 0) %></p>
      <% else %>
        <p class="text-sm text-secondary"><%= t("goals.savings_rate.insufficient_history") %></p>
      <% end %>
      <% if @dashboard.savings_rate.target_rate %>
        <p class="text-sm text-secondary"><%= t("goals.savings_rate.target", percent: number_to_percentage(@dashboard.savings_rate.target_rate * 100, precision: 0)) %></p>
      <% end %>
      <% if @dashboard.savings_rate.target_progress %>
        <p class="text-sm text-secondary"><%= t("goals.savings_rate.progress", percent: number_to_percentage(@dashboard.savings_rate.target_progress * 100, precision: 0)) %></p>
      <% end %>
      <% if @dashboard.savings_rate.review_prompts.include?(:fx_unavailable) %>
        <p class="text-sm text-warning"><%= t("goals.savings_rate.fx_unavailable") %></p>
      <% end %>
    </article>
  </section>

  <section class="bg-container shadow-border-xs rounded-xl p-5 space-y-4">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-lg text-primary font-medium"><%= t("goals.custom_goals.title") %></h2>
    </div>

    <% if @dashboard.custom_goals.any? %>
      <div class="grid md:grid-cols-2 gap-3">
        <% @dashboard.custom_goals.each do |goal_result| %>
          <% goal = @editing_financial_goal&.id == goal_result.goal.id ? @editing_financial_goal : goal_result.goal %>
          <article class="bg-surface rounded-lg p-4 space-y-2">
            <div class="flex items-start justify-between gap-3">
              <h3 class="text-primary font-medium"><%= goal.name %></h3>
              <%= button_to t("goals.custom_goals.archive"), archive_financial_goal_path(goal), method: :patch, class: "text-sm text-secondary underline" %>
            </div>
            <p class="text-sm text-secondary">
              <span class="privacy-sensitive"><%= goal_result.available_money.format %></span>
              of
              <span class="privacy-sensitive"><%= goal_result.target_money.format %></span>
            </p>
            <%= form_with model: goal, url: financial_goal_path(goal), method: :patch, class: "grid gap-3 border-t border-divider pt-3" do |form| %>
              <% if goal.errors.any? %>
                <%= render "shared/form_errors", model: goal %>
              <% end %>

              <%= form.hidden_field :goal_type, value: "custom" %>

              <div>
                <%= form.label :name, t("goals.custom_goals.name"), class: "block text-sm text-secondary mb-1" %>
                <%= form.text_field :name, class: "w-full bg-container border border-secondary rounded-lg px-3 py-2" %>
              </div>

              <div class="grid sm:grid-cols-3 gap-3">
                <div>
                  <%= form.label :target_amount, t("goals.custom_goals.target_amount"), class: "block text-sm text-secondary mb-1" %>
                  <%= form.number_field :target_amount, step: "0.01", class: "w-full bg-container border border-secondary rounded-lg px-3 py-2" %>
                </div>
                <div>
                  <%= form.label :target_currency, t("goals.custom_goals.currency"), class: "block text-sm text-secondary mb-1" %>
                  <%= form.text_field :target_currency, class: "w-full bg-container border border-secondary rounded-lg px-3 py-2" %>
                </div>
                <div>
                  <%= form.label :target_date, t("goals.custom_goals.target_date"), class: "block text-sm text-secondary mb-1" %>
                  <%= form.date_field :target_date, class: "w-full bg-container border border-secondary rounded-lg px-3 py-2" %>
                </div>
              </div>

              <fieldset class="space-y-2">
                <legend class="text-sm text-secondary"><%= t("goals.custom_goals.funding_accounts") %></legend>
                <% selected_account_ids = goal.funding_account_ids_for(Current.user).to_set %>
                <div class="grid sm:grid-cols-2 gap-2">
                  <% @accounts.each do |account| %>
                    <label class="flex items-center gap-2 text-sm text-primary">
                      <%= check_box_tag "financial_goal[funding_account_ids][]", account.id, selected_account_ids.include?(account.id) %>
                      <span><%= account.name %></span>
                    </label>
                  <% end %>
                </div>
              </fieldset>

              <div>
                <%= form.submit t("goals.custom_goals.update"), class: "px-3 py-2 bg-primary text-white rounded-lg" %>
              </div>
            <% end %>
            <% if goal_result.fx_unavailable? %>
              <p class="text-sm text-warning"><%= t("goals.custom_goals.fx_unavailable") %></p>
            <% end %>
          </article>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-secondary"><%= t("goals.custom_goals.empty") %></p>
    <% end %>

    <%= form_with model: @financial_goal, url: financial_goals_path, class: "grid md:grid-cols-2 gap-4 border-t border-divider pt-4" do |form| %>
      <% if @financial_goal.errors.any? %>
        <div class="md:col-span-2">
          <%= render "shared/form_errors", model: @financial_goal %>
        </div>
      <% end %>

      <%= form.hidden_field :goal_type, value: "custom" %>

      <div>
        <%= form.label :name, t("goals.custom_goals.name"), class: "block text-sm text-secondary mb-1" %>
        <%= form.text_field :name, class: "w-full bg-surface border border-secondary rounded-lg px-3 py-2", placeholder: "Example custom goal" %>
      </div>

      <div>
        <%= form.label :target_amount, t("goals.custom_goals.target_amount"), class: "block text-sm text-secondary mb-1" %>
        <%= form.number_field :target_amount, step: "0.01", class: "w-full bg-surface border border-secondary rounded-lg px-3 py-2" %>
      </div>

      <div>
        <%= form.label :target_currency, t("goals.custom_goals.currency"), class: "block text-sm text-secondary mb-1" %>
        <%= form.text_field :target_currency, class: "w-full bg-surface border border-secondary rounded-lg px-3 py-2" %>
      </div>

      <div>
        <%= form.label :target_date, t("goals.custom_goals.target_date"), class: "block text-sm text-secondary mb-1" %>
        <%= form.date_field :target_date, class: "w-full bg-surface border border-secondary rounded-lg px-3 py-2" %>
      </div>

      <fieldset class="md:col-span-2 space-y-2">
        <legend class="text-sm text-secondary"><%= t("goals.custom_goals.funding_accounts") %></legend>
        <div class="grid md:grid-cols-2 gap-2">
          <% @accounts.each do |account| %>
            <label class="flex items-center gap-2 text-sm text-primary">
              <%= check_box_tag "financial_goal[funding_account_ids][]", account.id, false %>
              <span><%= account.name %></span>
            </label>
          <% end %>
        </div>
      </fieldset>

      <div class="md:col-span-2">
        <%= form.submit t("goals.custom_goals.add"), class: "px-4 py-2 bg-primary text-white rounded-lg" %>
      </div>
    <% end %>
  </section>
</div>

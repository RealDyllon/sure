<%= content_for :page_title, t(".title") %>

<div class="bg-container shadow-border-xs rounded-xl p-4 grow overflow-y-auto">
  <p class="text-sm text-secondary mb-4"><%= app_version_label %></p>
  <%= render DS::Tabs.new(active_tab: @active_release_source, url_param_key: "source", testid: "release-history") do |tabs| %>
    <% tabs.with_nav do |nav| %>
      <% @release_histories.each do |source| %>
        <% nav.with_btn(id: source[:id], label: release_source_label(source)) %>
      <% end %>
    <% end %>
    <% @release_histories.each do |source| %>
      <% tabs.with_panel(tab_id: source[:id]) do %>
        <div class="space-y-4" data-release-source="<%= source[:id] %>">
          <%= link_to t("fork_releases.github_history"), "https://github.com/#{source[:repository]}/releases", target: "_blank", rel: "noopener noreferrer", class: "text-sm text-link hover:underline" %>
          <% if source[:unavailable] %>
            <%= render DS::Alert.new(title: t("fork_releases.unavailable"), message: t("fork_releases.retry"), variant: :warning) %>
          <% elsif source[:releases].empty? %>
            <%= render DS::Alert.new(message: t("fork_releases.empty")) %>
          <% end %>
          <% if source[:installed_unavailable] && source[:releases].any? %>
            <%= render DS::Alert.new(message: t("fork_releases.installed_unavailable", tag: source[:installed_tag])) %>
          <% end %>
          <% source[:releases].each_with_index do |release, index| %>
            <%= render "pages/release_entry", release: release, source: source, open: index.zero? %>
          <% end %>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>

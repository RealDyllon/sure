<div class="prose prose--github-release-notes text-sm text-secondary" data-release-acknowledgement="<%= @acknowledgement.to_json %>">
  <% @release_sections.each do |source| %>
    <section data-release-source="<%= source[:id] %>">
      <p class="font-medium text-primary"><%= release_source_label(source) %></p>
      <%= render "pages/release_notes", release_notes: source[:notes] %>
    </section>
  <% end %>
</div>

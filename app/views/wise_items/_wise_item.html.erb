<%# locals: (wise_item:) %>

<%= tag.div id: dom_id(wise_item) do %>
  <% unlinked_count = if defined?(@wise_unlinked_count_map) && @wise_unlinked_count_map
       @wise_unlinked_count_map[wise_item.id] || 0
     else
       wise_item.unlinked_accounts_count
     end %>

  <details open class="group bg-container p-4 shadow-border-xs rounded-xl">
    <summary class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <%= icon "chevron-right", class: "group-open:transform group-open:rotate-90" %>

        <div class="flex items-center justify-center h-8 w-8 bg-cyan-500/10 rounded-full">
          <div class="flex items-center justify-center">
            <%= tag.p "W", class: "text-cyan-600 text-xs font-medium" %>
          </div>
        </div>

        <div class="pl-1 text-sm">
          <div class="flex items-center gap-2">
            <%= tag.p wise_item.name, class: "font-medium text-primary" %>
            <% if wise_item.scheduled_for_deletion? %>
              <p class="text-destructive text-sm animate-pulse"><%= t("wise_items.wise_item.deletion_in_progress") %></p>
            <% end %>
          </div>
          <p class="text-xs text-secondary"><%= wise_item.institution_summary %></p>

          <% if wise_item.syncing? %>
            <div class="text-secondary flex items-center gap-1">
              <%= icon "loader", size: "sm", class: "animate-spin" %>
              <%= tag.span t("wise_items.wise_item.syncing") %>
            </div>
          <% elsif wise_item.sync_error.present? %>
            <div class="text-secondary flex items-center gap-1">
              <%= render DS::Tooltip.new(text: wise_item.sync_error, icon: "alert-circle", size: "sm", color: "destructive") %>
              <%= tag.span t("wise_items.wise_item.error"), class: "text-destructive" %>
            </div>
          <% else %>
            <p class="text-secondary">
              <% if wise_item.last_synced_at %>
                <%= t("wise_items.wise_item.status", timestamp: time_ago_in_words(wise_item.last_synced_at)) %>
                <% if wise_item.sync_status_summary.present? %>
                  • <%= wise_item.sync_status_summary %>
                <% end %>
              <% else %>
                <%= t("wise_items.wise_item.never_synced") %>
              <% end %>
            </p>
          <% end %>
        </div>
      </div>

      <% if Current.user&.admin? %>
        <div class="flex items-center gap-2">
          <%= button_to sync_wise_item_path(wise_item),
                method: :post,
                class: "button button--icon",
                disabled: wise_item.syncing?,
                title: "Sync Wise" do %>
            <%= icon "refresh-cw" %>
          <% end %>

          <%= render DS::Menu.new do |menu| %>
            <% if unlinked_count.to_i > 0 %>
              <% menu.with_item(
                variant: "link",
                text: t("wise_items.wise_item.set_up_balances"),
                icon: "settings",
                href: setup_accounts_wise_item_path(wise_item),
                frame: :modal
              ) %>
            <% end %>
            <% if wise_item.requires_update? %>
              <%# External OAuth redirect — the controller immediately %>
              <%# 302s to wise.com, so a top-level navigation is %>
              <%# required. Without `turbo: false`, Turbo intercepts %>
              <%# the click and handles the redirect inside a fetch %>
              <%# visit, which can swallow the external navigation. %>
              <% menu.with_item(
                variant: "link",
                text: t("wise_items.wise_item.reconnect"),
                icon: "refresh-cw",
                href: reauth_wise_item_path(wise_item),
                data: { turbo: false }
              ) %>
            <% end %>
            <% menu.with_item(
              variant: "button",
              text: t("wise_items.wise_item.delete"),
              icon: "trash-2",
              href: wise_item_path(wise_item),
              method: :delete,
              confirm: CustomConfirm.for_resource_deletion(wise_item.name, high_severity: true)
            ) %>
          <% end %>
        </div>
      <% end %>
    </summary>

    <% unless wise_item.scheduled_for_deletion? %>
      <div class="space-y-4 mt-4">
        <% if wise_item.accounts.any? %>
          <%= render "accounts/index/account_groups", accounts: wise_item.accounts %>
        <% end %>

        <% if wise_item.wise_cards.any? %>
          <div class="border border-primary rounded-lg p-3">
            <div class="flex items-center gap-2 mb-3">
              <%= icon "credit-card", size: "sm" %>
              <p class="text-sm font-medium text-primary"><%= t("wise_items.wise_card.section_title") %></p>
            </div>
            <div class="grid gap-2 md:grid-cols-2">
              <% wise_item.wise_cards.each do |card| %>
                <div class="rounded-lg bg-surface p-3 text-sm">
                  <div class="flex items-center justify-between gap-2">
                    <p class="font-medium text-primary"><%= card.card_type.to_s.titleize.presence || t("wise_items.wise_card.default_name") %></p>
                    <span class="text-xs text-secondary"><%= card.status.to_s.titleize.presence || "Unknown" %></span>
                  </div>
                  <p class="text-secondary mt-1">
                    <% if card.last_four.present? %>•••• <%= card.last_four %><% else %><%= t("wise_items.wise_card.no_card_number") %><% end %>
                    <% if card.expiry_month.present? && card.expiry_year.present? %>
                      • <%= t("wise_items.wise_card.expires", month: card.expiry_month.to_s.rjust(2, "0"), year: card.expiry_year) %>
                    <% end %>
                  </p>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>

        <% stats = if defined?(@wise_sync_stats_map) && @wise_sync_stats_map
             @wise_sync_stats_map[wise_item.id] || {}
           else
             wise_item.syncs.ordered.first&.sync_stats || {}
           end %>
        <%= render ProviderSyncSummary.new(
          stats: stats,
          provider_item: wise_item,
          institutions_count: wise_item.connected_institutions.size
        ) %>

        <% if unlinked_count.to_i > 0 %>
          <div class="p-4 flex flex-col gap-3 items-center justify-center">
            <p class="text-primary font-medium text-sm"><%= t("wise_items.wise_item.balances_need_setup_title") %></p>
            <p class="text-secondary text-sm"><%= t("wise_items.wise_item.balances_need_setup", count: unlinked_count) %></p>
            <% if Current.user&.admin? %>
              <%= render DS::Link.new(
                text: t("wise_items.wise_item.set_up_balances"),
                icon: "settings",
                variant: "primary",
                href: setup_accounts_wise_item_path(wise_item),
                frame: :modal
              ) %>
            <% else %>
              <p class="text-xs text-secondary italic"><%= t("wise_items.wise_item.ask_admin") %></p>
            <% end %>
          </div>
        <% end %>

        <div class="border border-primary rounded-lg p-3 space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <%= icon "repeat", size: "sm" %>
              <p class="text-sm font-medium text-primary"><%= t("wise_items.conversion_plans.section_title") %></p>
            </div>
          </div>

          <% plans = wise_item.family.wise_conversion_intentions.active.order(created_at: :desc) %>
          <% if plans.any? %>
            <div class="space-y-2">
              <% plans.each do |plan| %>
                <% snapshot = plan.latest_snapshot %>
                <div class="rounded-lg bg-surface p-3 text-sm flex items-center justify-between gap-3">
                  <div>
                    <p class="font-medium text-primary"><%= t("wise_items.conversion_plans.from_to", source: plan.source_currency, target: plan.target_currency) %></p>
                    <p class="text-secondary">
                      <%= plan.target_status_label %>
                      <% if snapshot&.provider_rate.present? %>
                        • <%= t("wise_items.conversion_plans.rate", rate: snapshot.provider_rate) %>
                      <% end %>
                      <% if snapshot&.rate_90d_percentile.present? %>
                        • <%= t("wise_items.conversion_plans.percentile_90d", percentile: snapshot.rate_90d_percentile) %>
                      <% end %>
                    </p>
                  </div>
                  <div class="flex items-center gap-2">
                    <%= button_to t("wise_items.conversion_plans.refresh"), refresh_wise_conversion_intention_path(plan), method: :post, class: "text-sm link" %>
                    <%= button_to t("wise_items.conversion_plans.delete"), wise_conversion_intention_path(plan), method: :delete, class: "text-sm text-destructive" %>
                  </div>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-secondary"><%= t("wise_items.conversion_plans.none") %></p>
          <% end %>

          <% if Current.user&.admin? %>
            <%= form_with model: WiseConversionIntention.new,
                          url: wise_conversion_intentions_path,
                          method: :post,
                          data: { turbo_frame: "_top" },
                          class: "grid gap-2 md:grid-cols-6" do |form| %>
              <%= form.collection_select :source_account_id,
                    wise_item.accounts,
                    :id,
                    :name,
                    { include_blank: t("wise_items.conversion_plans.new.source_account_placeholder") },
                    class: "appearance-none bg-container border border-primary rounded-md px-3 py-2 text-sm text-primary md:col-span-2" %>
              <%= form.text_field :source_currency, placeholder: t("wise_items.conversion_plans.new.from_placeholder"), class: "bg-container border border-primary rounded-md px-3 py-2 text-sm text-primary" %>
              <%= form.text_field :target_currency, placeholder: t("wise_items.conversion_plans.new.to_placeholder"), class: "bg-container border border-primary rounded-md px-3 py-2 text-sm text-primary" %>
              <%= form.number_field :target_amount, step: "0.01", placeholder: t("wise_items.conversion_plans.new.amount_placeholder"), class: "bg-container border border-primary rounded-md px-3 py-2 text-sm text-primary" %>
              <%= form.number_field :desired_rate, step: "0.0001", placeholder: t("wise_items.conversion_plans.new.target_rate_placeholder"), class: "bg-container border border-primary rounded-md px-3 py-2 text-sm text-primary" %>
              <%= form.date_field :deadline_on, class: "bg-container border border-primary rounded-md px-3 py-2 text-sm text-primary md:col-span-2" %>
              <%= form.text_field :notes, placeholder: t("wise_items.conversion_plans.new.notes_placeholder"), class: "bg-container border border-primary rounded-md px-3 py-2 text-sm text-primary md:col-span-3" %>
              <%= form.submit t("wise_items.conversion_plans.new.submit"), class: "rounded-lg px-3 py-2 text-sm font-medium text-inverse button-bg-primary" %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>
  </details>
<% end %>

<%= content_for :previous_path, categories_path %>
<%= content_for :cancel_path, categories_path %>

<%= content_for :header_nav do %>
  <div class="flex items-center gap-2 text-sm text-secondary">
    <% steps = [ "Start", "Review", "Done" ] %>
    <% steps.each_with_index do |step, index| %>
      <span class="<%= index.zero? || (step == "Review" && (@run.generating? || @run.reviewing? || @run.applying?)) || (step == "Done" && @run.complete?) ? "text-primary font-medium" : "" %>"><%= step %></span>
      <% unless index == steps.size - 1 %>
        <%= icon "chevron-right", size: "sm" %>
      <% end %>
    <% end %>
  </div>
<% end %>

<div class="max-w-6xl mx-auto space-y-6">
  <div class="space-y-2">
    <h1 class="text-3xl font-semibold text-primary">AI category cleanup</h1>
    <p class="text-sm text-secondary">
      <%= @run.category_snapshot.size %> categories snapshotted
      <% if @run.provider_name.present? %>
        - <%= @run.provider_name %>
      <% end %>
    </p>
  </div>

  <% if @run.generating? || @run.applying? %>
    <% polling_data = { controller: "page-polling", page_polling_url_value: category_cleanup_run_path(@run), page_polling_interval_value: 3000 } %>
    <div class="bg-container rounded-xl shadow-border-xs p-4 space-y-4" data-controller="<%= polling_data[:controller] %>" data-page-polling-url-value="<%= polling_data[:page_polling_url_value] %>" data-page-polling-interval-value="<%= polling_data[:page_polling_interval_value] %>">
      <%= render "imports/processing_progress", import: @run %>
      <div class="flex items-center gap-2">
        <%= render DS::Link.new(text: "Refresh", icon: "refresh-cw", href: category_cleanup_run_path(@run), variant: "outline") %>
        <% if @run.processing_progress_stale? && @run.retryable_processing? %>
          <%= button_to "Retry", retry_category_cleanup_run_path(@run), method: :post, class: "button button--primary" %>
        <% end %>
      </div>
    </div>
  <% elsif @run.empty? %>
    <div class="bg-container rounded-xl shadow-border-xs p-6 space-y-4">
      <h2 class="text-lg font-medium text-primary">No cleanup suggestions</h2>
      <p class="text-sm text-secondary">There are no category cleanup suggestions to review right now.</p>
      <%= render DS::Link.new(text: "Back to Categories", href: categories_path, variant: "primary") %>
    </div>
  <% elsif @run.failed? %>
    <div class="bg-container rounded-xl shadow-border-xs p-6 space-y-4">
      <h2 class="text-lg font-medium text-primary">Cleanup generation failed</h2>
      <p class="text-sm text-secondary"><%= @run.error.presence || "AI category cleanup failed." %></p>
      <div class="flex items-center gap-2">
        <%= button_to "Retry", retry_category_cleanup_run_path(@run), method: :post, class: "button button--primary" %>
        <%= render DS::Link.new(text: "Back to Categories", href: categories_path, variant: "outline") %>
      </div>
    </div>
  <% elsif @run.reviewing? || @run.complete? %>
    <div class="bg-container rounded-xl shadow-border-xs overflow-hidden">
      <div class="p-4 border-b border-secondary space-y-4">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-lg font-medium text-primary">Review cleanup suggestions</h2>
            <p class="text-sm text-secondary"><%= @run.suggestions.selected.actionable.count %> selected across all pages</p>
          </div>
          <% if @run.complete? %>
            <div class="text-sm text-secondary">
              <%= @run.applied_count %> applied - <%= @run.skipped_count %> skipped - <%= @run.unchanged_count %> unchanged
            </div>
          <% end %>
        </div>

        <%= form_with url: category_cleanup_run_path(@run), method: :get, class: "grid grid-cols-1 md:grid-cols-[1fr_auto_auto_auto_auto_auto] gap-2" do |form| %>
          <%= hidden_field_tag :per_page, @per_page %>
          <%= form.text_field :q, value: params[:q], placeholder: "Search", class: "form-field__input" %>
          <%= form.select :status, options_for_select([ [ "Any status", "" ], [ "Suggested", "suggested" ], [ "Needs review", "needs_review" ], [ "Applied", "applied" ], [ "Skipped", "skipped" ], [ "Unchanged", "unchanged" ] ], params[:status]), {}, class: "form-field__input" %>
          <%= form.select :filter_action, options_for_select([ [ "Any action", "" ], [ "Merge", "merge" ], [ "Rename", "rename" ], [ "Reparent", "reparent" ], [ "Keep", "keep" ] ], params[:filter_action]), {}, class: "form-field__input" %>
          <%= form.select :selected, options_for_select([ [ "Any selection", "" ], [ "Selected", "true" ], [ "Unselected", "false" ] ], params[:selected]), {}, class: "form-field__input" %>
          <%= form.select :category_id, options_for_select([ [ "Any category", "" ] ] + @categories.map { |category| [ category.name_with_parent, category.id ] }, params[:category_id]), {}, class: "form-field__input" %>
          <button class="button button--secondary" type="submit">Filter</button>
        <% end %>
      </div>

      <% if @suggestions.any? %>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="text-secondary border-b border-secondary">
              <tr>
                <th class="text-left p-3 font-medium">Category</th>
                <th class="text-left p-3 font-medium">Action</th>
                <th class="text-left p-3 font-medium">Target / name / parent</th>
                <th class="text-left p-3 font-medium">Review</th>
                <th class="text-left p-3 font-medium">Status</th>
                <th class="text-right p-3 font-medium"></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-secondary">
              <% @suggestions.each do |suggestion| %>
                <tr>
                  <td class="p-3 min-w-56">
                    <div class="font-medium text-primary"><%= suggestion.source_category&.name_with_parent || suggestion.source_category_name || "Deleted category" %></div>
                    <% if suggestion.rationale.present? %>
                      <div class="text-xs text-secondary mt-1"><%= suggestion.rationale %></div>
                    <% end %>
	                  </td>
	                  <% if @run.reviewing? %>
	                    <td class="p-3" colspan="5">
	                      <%= form_with url: suggestion_category_cleanup_run_path(@run, suggestion, request.query_parameters), method: :patch, class: "grid grid-cols-1 xl:grid-cols-[160px_1fr_auto_auto_auto] gap-2 items-start" do %>
	                        <%= select_tag :suggested_action,
	                              options_for_select([ [ "Merge", "merge" ], [ "Rename", "rename" ], [ "Reparent", "reparent" ], [ "Keep", "keep" ] ], suggestion.suggested_action),
	                              class: "form-field__input" %>

	                        <div class="space-y-2">
	                          <div class="grid grid-cols-1 lg:grid-cols-3 gap-2">
	                            <%= select_tag :target_category_id,
	                                  options_for_select([ [ "Merge target", "" ] ] + @categories.map { |category| [ category.name_with_parent, category.id ] }, suggestion.target_category_id),
	                                  class: "form-field__input" %>
	                            <%= text_field_tag :new_name, suggestion.new_name, placeholder: "New name", class: "form-field__input" %>
	                            <%= select_tag :parent_category_id,
	                                  options_for_select([ [ "Root category", "" ] ] + @root_categories.map { |category| [ category.name, category.id ] }, suggestion.parent_category_id),
	                                  class: "form-field__input" %>
	                          </div>
	                          <% if suggestion.review_error.present? %>
	                            <p class="text-xs text-warning"><%= suggestion.review_error %></p>
	                          <% end %>
	                        </div>

	                        <div class="pt-2 whitespace-nowrap">
	                          <%= hidden_field_tag :suggestion_selected, "false" %>
	                          <label class="inline-flex items-center gap-2">
	                            <%= check_box_tag :suggestion_selected, "true", suggestion.selected?, class: "checkbox checkbox--light" %>
	                            <span>Use</span>
	                          </label>
	                        </div>
	                        <div class="pt-2 text-secondary"><%= suggestion.status.humanize %></div>
	                        <button class="button button--secondary" type="submit">Save</button>
	                      <% end %>
	                    </td>
	                  <% else %>
                    <td class="p-3"><%= suggestion.suggested_action.humanize %></td>
                    <td class="p-3">
                      <% if suggestion.action_merge? %>
                        Merge into <%= suggestion.target_category_name.presence || suggestion.target_category&.name || "missing target" %>
                      <% elsif suggestion.action_rename? %>
                        Rename to <%= suggestion.new_name.presence || "missing name" %>
                      <% elsif suggestion.action_reparent? %>
                        Move under <%= suggestion.parent_category_name.presence || suggestion.parent_category&.name || "root category" %>
                      <% else %>
                        No change
                      <% end %>
                      <% if suggestion.error.present? %>
                        <p class="text-xs text-warning mt-2"><%= suggestion.error %></p>
                      <% end %>
                    </td>
                    <td class="p-3"><%= suggestion.selected? ? "Selected" : "Unselected" %></td>
                    <td class="p-3"><%= suggestion.status.humanize %></td>
                    <td class="p-3"></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="p-8 text-center space-y-3">
          <p class="text-sm text-secondary">No cleanup suggestions match these filters.</p>
          <%= render DS::Link.new(text: "Clear filters", href: category_cleanup_run_path(@run, per_page: @per_page), variant: "outline") %>
        </div>
      <% end %>

      <% if @pagy %>
        <div class="p-4 border-t border-secondary">
          <%= render "shared/pagination", pagy: @pagy %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<% if @run.reviewing? %>
  <%= content_for :footer do %>
    <div class="fixed bottom-0 left-0 right-0 bg-container border-t border-secondary px-8 py-4">
      <div class="max-w-6xl mx-auto flex items-center justify-between gap-4">
        <div class="text-sm text-secondary">
          <span class="font-medium text-primary"><%= @run.suggestions.selected.actionable.count %></span>
          selected cleanup suggestions
        </div>
        <%= button_to "Apply selected", apply_category_cleanup_run_path(@run, request.query_parameters), method: :post, class: "button button--primary", disabled: @run.suggestions.selected.actionable.none? %>
      </div>
    </div>
  <% end %>
<% end %>
